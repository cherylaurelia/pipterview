# Copy to .env.local and fill in. Superset workspaces copy .env.local from the
# main checkout automatically (see .superset/setup.sh).

# Claude API key: https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to use a scripted interviewer instead of Claude (no key or credits needed).
# MOCK_AI=1

# Optional model override. Must support mid-conversation system messages.
# CLAUDE_MODEL=claude-opus-5-5

# Optional: a natural interviewer voice via ElevenLabs (falls back to the browser voice).
# Pick a warm, friendly voice for Pip in the ElevenLabs voice library and paste its ID.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_SPEED=1

# Java and C++ compile and run on the server. On by default in development only,
# because it executes candidate code with the server's permissions.
# LOCAL_CODE_RUNNER=1
