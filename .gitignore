# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Superset per-workspace state (generated by .superset/setup.sh)
.superset/port
.superset/ports.json
.superset/config.local.json

# env templates are tracked
!.env.example
.dev.vars
.venv/

# Question ratings (see src/lib/ratings.ts)
/data/

# Java/C++ runner scratch folders (src/lib/server/native-runner.ts)
/.runs/
